<!--
  MUDANÇA: o SDK passou de "Microsoft.NET.Sdk" para "Microsoft.NET.Sdk.Web".
  É isso que traz o servidor web (Kestrel) e o ASP.NET Core para dentro do projeto.
  O <OutputType>Exe</OutputType> deixou de ser necessário: o SDK Web já cria um executável.
-->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

</Project>
